# =====================================================================
# Unified configuration for the automation framework.
#
# All secrets and runtime knobs live in this single .env file. The same
# file is read by docker-compose, systemd, the CLI, the workers, and the
# Telegram controller — so there is exactly ONE place to look.
#
# Two override mechanisms are available:
#
#   1. First-class env vars (read directly by the code below):
#        AUTOMATION_API_TOKEN, AUTOMATION_API_URL, AUTOMATION_CONFIG,
#        AUTOMATION_HOST, AUTOMATION_PORT,
#        TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_CHAT_IDS.
#
#   2. Generic dotted overrides for ANY key in config/config.json:
#        AUTOMATION__SECTION__KEY=value
#      e.g. AUTOMATION__SCHEDULER__MAX_WORKERS=20 sets scheduler.max_workers.
#
# Copy this file to .env and fill in real values. Never commit the .env.
# =====================================================================


# --------------------------------------------------------------------- API
# Token that protects every HTTP endpoint. If unset, the API runs in OPEN
# mode (development only) and warns on startup.
# Generate one with:  openssl rand -hex 32
AUTOMATION_API_TOKEN=

# URL the CLI / Telegram bot / workers connect to. Leave as default for a
# single-node install. Point at a coordinator hostname for distributed mode.
AUTOMATION_API_URL=http://127.0.0.1:8080

# (Optional) override config file path / bind address / port.
# AUTOMATION_CONFIG=config/config.json
# AUTOMATION_HOST=0.0.0.0
# AUTOMATION_PORT=8080


# ---------------------------------------------------------------- Telegram
# Telegram is the framework's primary control center. Once these are set,
# the bot can plan, execute, watch, cancel, resume and replay every kind of
# task without anyone editing JSON/YAML or shelling into the host.
#
# 1. Talk to @BotFather on Telegram to create a bot and get a token.
# 2. Get your chat_id (e.g. via @userinfobot) and add it to the allow-list.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321


# -------------------------------------------------------------------- AI
# AI provider key(s). The brain falls back gracefully if nothing is set,
# but configured runs will use a richer LLM-driven planner.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Default model used by the planner when no per-call override is given.
# Override config.json -> ai.model via the AUTOMATION__ prefix.
# AUTOMATION__AI__MODEL=llama-3.3-70b-versatile
# AUTOMATION__AI__MAX_HEAL_ATTEMPTS=3


# ---------------------------------------------------------- callback HMAC
# Optional shared secret for signing webhook / inter-service callbacks.
# Generate with:  openssl rand -hex 32
# CALLBACK_HMAC_KEY=


# ----------------------------------------------------------- parallelism
# Cap concurrent agent / worker tasks. Both keys map onto config.json via
# the AUTOMATION__ override prefix.
# AUTOMATION__SCHEDULER__MAX_WORKERS=10
# AUTOMATION__AGENT__MAX_PARALLEL=4


# ---------------------------------------------------------- common knobs
# These are useful examples of the dotted override syntax. Anything in
# config/config.json can be set this way without editing the file.
# AUTOMATION__LOGGING__LEVEL=INFO
# AUTOMATION__PLAYWRIGHT__HEADLESS=true
# AUTOMATION__AGENT__DEFAULT_TIMEOUT_SECONDS=120
# AUTOMATION__AGENT__VERIFICATION_THRESHOLD=0.6
# AUTOMATION__DASHBOARD__ENABLED=true
# =============================================================================
#  SINGLE SOURCE OF TRUTH FOR SECRETS
# =============================================================================
#  Copy this file to `.env` and fill in your values. The framework reads this
#  file FIRST and overlays it onto config/master_config.json. After filling
#  values here, you should not need to edit any other configuration file.
#
#  Generate a token: openssl rand -hex 32
# =============================================================================

# -- Telegram (the primary control surface) ----------------------------------
# Required to enable the Telegram command center.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs allowed to issue commands. The bot rejects all
# other senders silently. Use @userinfobot in Telegram to find your chat ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: chat ID that receives unsolicited live-monitoring updates.
# Defaults to the first allowed chat id when blank.
TELEGRAM_DEFAULT_CHAT_ID=


# -- AI providers ------------------------------------------------------------
# Groq is the default planner backend. Get a key at https://console.groq.com.
GROQ_API_KEY=

# Optional secondary providers. If GROQ_API_KEY is missing the framework will
# fall back to whichever of these is configured (in order).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# -- Local API (FastAPI control plane) ---------------------------------------
# Bearer token for the HTTP API. Leave blank only on a private machine.
AUTOMATION_API_TOKEN=

# URL the Telegram bot, CLI, and workers use to reach the local API.
AUTOMATION_API_URL=http://127.0.0.1:8080

# HMAC key used to sign callback payloads (Telegram callback queries, webhook
# bodies). Generate with: openssl rand -hex 32
CALLBACK_HMAC_KEY=


# -- Browser ----------------------------------------------------------------
# `true` for production, `false` to see the browser locally for debugging.
HEADLESS=true

# Default per-action timeout (seconds) when no specific timeout is given.
DEFAULT_TIMEOUT=60


# -- Execution --------------------------------------------------------------
# Maximum browser workers running concurrently across all accounts.
MAX_PARALLEL_WORKERS=5

# Per-goal retry budget before the supervisor declares failure.
MAX_RETRIES=3


# -- Storage ----------------------------------------------------------------
SCREENSHOT_PATH=data/screenshots
RUNS_PATH=data/runs
TEMPLATES_PATH=data/templates
LEARNING_PATH=data/learning


# -- AI models --------------------------------------------------------------
# Groq Qwen models are the default. The "planner" handles instruction parsing
# and goal decomposition; the "reasoning" model is used for recovery strategy.
DEFAULT_PLANNER_MODEL=qwen/qwen3-32b
DEFAULT_REASONING_MODEL=qwen-qwq-32b
