# Copy to .env and fill in values. Loaded by docker-compose and systemd.

# API authentication. Generate with: openssl rand -hex 32
AUTOMATION_API_TOKEN=

# URL the CLI / Telegram / workers connect to
AUTOMATION_API_URL=http://127.0.0.1:8080

# Optional: enable Telegram remote control
# TELEGRAM_BOT_TOKEN=123456:ABCDEF
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Optional: override config keys via AUTOMATION__SECTION__KEY=value
# AUTOMATION__SCHEDULER__MAX_WORKERS=20
