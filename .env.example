# =============================================================================
#  SINGLE SOURCE OF TRUTH FOR SECRETS
# =============================================================================
#  Copy this file to `.env` and fill in your values. The framework reads this
#  file FIRST and overlays it onto config/master_config.json. After filling
#  values here, you should not need to edit any other configuration file.
#
#  Generate a token: openssl rand -hex 32
# =============================================================================

# -- Telegram (the primary control surface) ----------------------------------
# Required to enable the Telegram command center.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs allowed to issue commands. The bot rejects all
# other senders silently. Use @userinfobot in Telegram to find your chat ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: chat ID that receives unsolicited live-monitoring updates.
# Defaults to the first allowed chat id when blank.
TELEGRAM_DEFAULT_CHAT_ID=


# -- AI providers ------------------------------------------------------------
# Groq is the default planner backend. Get a key at https://console.groq.com.
GROQ_API_KEY=

# Optional secondary providers. If GROQ_API_KEY is missing the framework will
# fall back to whichever of these is configured (in order).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# -- Local API (FastAPI control plane) ---------------------------------------
# Bearer token for the HTTP API. Leave blank only on a private machine.
AUTOMATION_API_TOKEN=

# URL the Telegram bot, CLI, and workers use to reach the local API.
AUTOMATION_API_URL=http://127.0.0.1:8080

# HMAC key used to sign callback payloads (Telegram callback queries, webhook
# bodies). Generate with: openssl rand -hex 32
CALLBACK_HMAC_KEY=


# -- Browser ----------------------------------------------------------------
# `true` for production, `false` to see the browser locally for debugging.
HEADLESS=true

# Default per-action timeout (seconds) when no specific timeout is given.
DEFAULT_TIMEOUT=60


# -- Execution --------------------------------------------------------------
# Maximum browser workers running concurrently across all accounts.
MAX_PARALLEL_WORKERS=5

# Per-goal retry budget before the supervisor declares failure.
MAX_RETRIES=3


# -- Storage ----------------------------------------------------------------
SCREENSHOT_PATH=data/screenshots
RUNS_PATH=data/runs
TEMPLATES_PATH=data/templates
LEARNING_PATH=data/learning


# -- AI models --------------------------------------------------------------
# Groq Qwen models are the default. The "planner" handles instruction parsing
# and goal decomposition; the "reasoning" model is used for recovery strategy.
DEFAULT_PLANNER_MODEL=qwen/qwen3-32b
DEFAULT_REASONING_MODEL=qwen-qwq-32b
